{
    "name": "cardemulate",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "description": "CardEmulate - 电子卡牌拆包模拟器（Topps / Panini 等卡牌盒在线开盒）",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview --port 4173",
        "typecheck": "vue-tsc --noEmit",
        "db:local": "wrangler d1 execute DB --local --file=schema.sql",
        "smoke": "node scripts/smoke-api.mjs",
        "dev:cf": "vite build && wrangler pages dev dist --compatibility-date=2026-01-01"
    },
    "dependencies": {
        "vue": "^3.5.13",
        "vue-router": "^4.5.0"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^5.2.1",
        "typescript": "^5.7.2",
        "vite": "^6.0.11",
        "vue-tsc": "^2.2.0"
    }
}
