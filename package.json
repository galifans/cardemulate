{
    "name": "cardemulate",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "description": "CardEmulate - 电子卡牌拆包模拟器（Topps / Panini 等卡牌盒在线开盒）",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview --port 4173",
        "typecheck": "vue-tsc --noEmit",
        "roster:check": "node scripts/check-roster.mjs",
        "db:local": "wrangler d1 execute DB --local --file=schema.sql",
        "db:backfill": "esbuild scripts/backfill-break-values.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.json --outfile=.snapshot/backfill-break-values.mjs --log-level=warning && node .snapshot/backfill-break-values.mjs",
        "smoke": "node scripts/smoke-api.mjs",
        "dev:cf": "vite build && wrangler pages dev dist --compatibility-date=2026-01-01",
        "boxes:snapshot": "esbuild scripts/snapshot-boxes.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.json --outfile=.snapshot/snapshot-boxes.mjs --log-level=warning && node .snapshot/snapshot-boxes.mjs snapshot",
        "boxes:check": "esbuild scripts/snapshot-boxes.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.json --outfile=.snapshot/snapshot-boxes.mjs --log-level=warning && node .snapshot/snapshot-boxes.mjs check",
        "prices:check": "esbuild scripts/check-prices.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.json --outfile=.snapshot/check-prices.mjs --log-level=warning && node .snapshot/check-prices.mjs",
        "prices:probe": "node scripts/probe-price-sites.mjs",
        "prices:fit": "esbuild scripts/fit-sales-model.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.json --outfile=.snapshot/fit-sales-model.mjs --log-level=warning && node .snapshot/fit-sales-model.mjs",
        "prices:audit": "esbuild scripts/check-sales-fit.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.json --outfile=.snapshot/check-sales-fit.mjs --log-level=warning && node .snapshot/check-sales-fit.mjs",
        "sales:scrape": "node scripts/scrape-card-sales.mjs",
        "draft:import": "node scripts/import-draft-order.mjs",
        "print:check": "esbuild scripts/check-print-runs.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.json --outfile=.snapshot/check-print-runs.mjs --log-level=warning && node .snapshot/check-print-runs.mjs"
    },
    "dependencies": {
        "vue": "^3.5.13",
        "vue-router": "^4.5.0"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^5.2.1",
        "typescript": "^5.7.2",
        "vite": "^6.0.11",
        "vue-tsc": "^2.2.0"
    }
}
